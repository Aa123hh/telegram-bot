# Copy to .env on Ubuntu. Never commit actual values.
BOT_TOKEN=REPLACE_WITH_TELEGRAM_BOT_TOKEN
ALLOWED_TELEGRAM_USER_IDS=123456789
# Optional: only enable after confirming a separate, approved BRAIN instance.
ALWATHIQ_BRAIN_URL=
ALWATHIQ_BRAIN_TOKEN=
BRAIN_TIMEOUT_SECONDS=5
COMMAND_COOLDOWN_SECONDS=2
# Keep false unless connecting over a private and explicitly controlled network.
ALLOW_INTERNAL_HTTP=false
