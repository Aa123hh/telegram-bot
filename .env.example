# Copy to .env on Ubuntu. Never commit actual values.
BOT_TOKEN=REPLACE_WITH_TELEGRAM_BOT_TOKEN
ALLOWED_TELEGRAM_USER_IDS=123456789
# Optional: only enable after confirming a separate, approved BRAIN instance.
ALWATHIQ_BRAIN_URL=
ALWATHIQ_BRAIN_TOKEN=
BRAIN_TIMEOUT_SECONDS=5
COMMAND_COOLDOWN_SECONDS=2
# Keep false unless connecting over a private and explicitly controlled network.
ALLOW_INTERNAL_HTTP=false

# Optional, opt-in: direct RouterOS HTTPS REST from the Ubuntu host.
# Leave blank to keep RouterOS network actions unavailable.
# Requires www-ssl and a verifiable certificate; NEVER enable www/plain HTTP.
ROUTEROS_HTTPS_URL=
ROUTEROS_USERNAME=
ROUTEROS_PASSWORD=
# CA file inside the container, e.g. /etc/alwathiq/ca/router.crt.
ROUTEROS_CA_FILE=
ROUTEROS_TIMEOUT_SECONDS=5
# Must also be in ALLOWED_TELEGRAM_USER_IDS.
ROUTEROS_OWNER_TELEGRAM_IDS=
# Both false by default; no production network changes until explicitly approved.
ROUTEROS_WRITES_ENABLED=false
ROUTEROS_CRITICAL_ENABLED=false
